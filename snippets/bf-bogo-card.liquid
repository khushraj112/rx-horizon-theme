{%- doc -%}
  Reusable BOGO offer card, driven by explicit values from one "BOGO Offer" Theme Editor block.

  This card only DISPLAYS the offer and adds the products to the cart through the Ajax cart API.
  It never applies or calculates a discount: the matching native Shopify Buy X Get Y automatic
  discount must be configured separately in the admin (it is NOT synced with these settings).

  @param {string} uid - Unique id for this offer (block id)
  @param {string} [title] - Offer title
  @param {product} qualifying - Qualifying product
  @param {product} reward_1 - First reward product (required)
  @param {product} [reward_2] - Optional alternative reward
  @param {product} [reward_3] - Optional alternative reward
  @param {number} [q_qty] - Qualifying quantity
  @param {number} [r_qty] - Reward quantity
  @param {string} [dtype] - 'percentage' or 'fixed'
  @param {number} [dval] - Discount value shown as information only
  @param {string} [label] - Promotional label
  @param {string} [note] - Pre-launch message
{%- enddoc -%}

{%- liquid
  assign q = qualifying
  assign reward_count = 1
  if reward_2 != blank
    assign reward_count = reward_count | plus: 1
  endif
  if reward_3 != blank
    assign reward_count = reward_count | plus: 1
  endif
  assign slots = '1,2,3' | split: ','
  assign q_qty = q_qty | default: 1
  assign r_qty = r_qty | default: 1
  assign dval_int = dval | round
  assign deal = blank
  if dval != blank and dval > 0
    if dtype == 'fixed'
      assign dval_cents = dval | times: 100
      assign deal = dval_cents | money | append: ' off'
    elsif dval >= 100
      assign deal = 'Free'
    elsif dval_int == dval
      assign deal = dval_int | append: '% off'
    else
      assign deal = dval | append: '% off'
    endif
  endif
-%}

<bf-bogo class="bf-bogo" data-offer="{{ uid }}">
  <p class="bf-bogo__headline">Buy {{ q_qty }} get {{ r_qty }}{% if deal != blank %} &mdash; {{ deal | upcase }}{% endif %}</p>
  {%- if title != blank -%}<h3>{{ title }}</h3>{%- endif -%}
  {%- if label != blank -%}
    <p class="bf-badge bf-badge--static">{{ label }}</p>
  {%- endif -%}

  <div class="bf-bogo__pair">
    <div class="bf-bogo__item" data-role="qualifying" data-qty="{{ q_qty }}">
      <span class="bf-role">Buy {{ q_qty }}</span>
      {% render 'bf-bogo-item', product: q %}
    </div>

    <div class="bf-bogo__rewards">
      {%- for slot in slots -%}
        {%- liquid
          case slot
            when '1'
              assign r = reward_1
            when '2'
              assign r = reward_2
            else
              assign r = reward_3
          endcase
        -%}
        {%- if r != blank -%}
        {%- if reward_count > 1 -%}
          <label class="bf-bogo__item bf-bogo__item--pick" data-role="reward" data-qty="{{ r_qty }}">
            <input type="radio" name="bf-reward-{{ uid }}" {% if forloop.first %}checked{% endif %} aria-label="Choose {{ r.title | escape }}">
            <span class="bf-role">Choose your reward &times;{{ r_qty }}</span>
            {% render 'bf-bogo-item', product: r %}
          </label>
        {%- else -%}
          <div class="bf-bogo__item" data-role="reward" data-qty="{{ r_qty }}">
            <span class="bf-role">Get {{ r_qty }}{% if deal != blank %} &middot; {{ deal }}{% endif %}</span>
            {% render 'bf-bogo-item', product: r %}
          </div>
        {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- if deal != blank and reward_count > 1 -%}
    <p class="bf-bogo__deal">Reward: {{ deal }}</p>
  {%- endif -%}
  {%- if note != blank -%}<p class="bf-note">{{ note }}</p>{%- endif -%}
  <button type="button" class="bf-btn" data-bf-add-both>Add Both Products</button>
  <p class="bf-msg" data-bf-msg role="status" aria-live="polite"></p>
</bf-bogo>
