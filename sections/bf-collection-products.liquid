{%- comment -%}
  Collection Product Section: reusable for "Flagship Deals", "Bestsellers", or any campaign list.
  Products come from the picked collection (no hardcoded product IDs).
{%- endcomment -%}

{{ 'bf-campaign.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign col = section.settings.collection
  assign carousel = false
  if section.settings.display == 'carousel'
    assign carousel = true
  endif
  assign use_featured = false
  if section.settings.featured_first and carousel == false
    assign use_featured = true
  endif
  assign promo = true
  unless section.settings.show_promo
    assign promo = false
  endunless
-%}

{%- if section.settings.enabled -%}
  <div class="bf-sec" style="--bf-from: {{ section.settings.bg_from }}; --bf-to: {{ section.settings.bg_to }};">
    <div class="bf-sec__in">
      {%- if section.settings.heading != blank -%}
        <h2 {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="bf-sub">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- if col == blank or col.products_count == 0 -%}
        <p class="bf-sec__empty">{% if col == blank %}Pick a collection in the Theme Editor.{% else %}This collection has no products.{% endif %}</p>
      {%- elsif carousel -%}
        <bf-carousel class="bf-carousel">
          <div class="bf-track" data-bf-track>
            {%- for product in col.products limit: section.settings.limit -%}
              {% render 'bf-product-card', product: product, show_promo: promo %}
            {%- endfor -%}
          </div>
          <div class="bf-carousel__nav">
            <button type="button" class="bf-arrow" data-bf-prev aria-label="Previous">&larr;</button>
            <button type="button" class="bf-arrow" data-bf-next aria-label="Next">&rarr;</button>
          </div>
        </bf-carousel>
      {%- else -%}
        <div class="bf-grid">
          {%- for product in col.products limit: section.settings.limit -%}
            {%- assign is_featured = false -%}
            {%- if use_featured and forloop.first -%}{%- assign is_featured = true -%}{%- endif -%}
            {% render 'bf-product-card', product: product, featured: is_featured, show_promo: promo %}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
  <script src="{{ 'bf-demo.js' | asset_url }}" type="module" async></script>
{%- endif -%}

{% schema %}
{
  "name": "Collection products",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show section", "default": true },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Flagship Deals" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Used by the Campaign tabs, e.g. bf-flagship." },
    { "type": "range", "id": "limit", "label": "Max products", "min": 1, "max": 24, "default": 6 },
    {
      "type": "select",
      "id": "display",
      "label": "Display",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    { "type": "checkbox", "id": "featured_first", "label": "Feature the first product (grid only)", "default": false },
    { "type": "checkbox", "id": "show_promo", "label": "Show promotion label", "default": true },
    { "type": "color", "id": "bg_from", "label": "Background gradient: top", "default": "#5a2a10" },
    { "type": "color", "id": "bg_to", "label": "Background gradient: bottom", "default": "#6b2a1c" }
  ],
  "presets": [{ "name": "Collection products" }]
}
{% endschema %}
