{%- comment -%}
  Campaign Hero: heading, description, background image, CTA, optional countdown, optional email signup.
{%- endcomment -%}

{{ 'bf-campaign.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enabled -%}
  <div class="bf-sec bf-hero" style="--bf-from: {{ section.settings.bg_from }}; --bf-to: {{ section.settings.bg_to }};">
    {%- if section.settings.image != blank -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'bf-hero__bg', loading: 'eager', alt: '', widths: '800, 1200, 1600, 2000', sizes: '100vw' }}
    {%- endif -%}
    <div class="bf-sec__in">
      <h1>{{ section.settings.heading }}</h1>
      {%- if section.settings.description != blank -%}<p>{{ section.settings.description }}</p>{%- endif -%}

      {%- if section.settings.cta_text != blank and section.settings.cta_link != blank -%}
        <a class="bf-btn" href="{{ section.settings.cta_link }}">{{ section.settings.cta_text }}</a>
      {%- endif -%}

      {%- if section.settings.countdown_end != blank -%}
        <bf-countdown class="bf-countdown" data-end="{{ section.settings.countdown_end | escape }}" hidden>
          <div class="bf-countdown__unit"><b data-d>0</b><span>Days</span></div>
          <div class="bf-countdown__unit"><b data-h>0</b><span>Hours</span></div>
          <div class="bf-countdown__unit"><b data-m>0</b><span>Mins</span></div>
          <div class="bf-countdown__unit"><b data-s>0</b><span>Secs</span></div>
        </bf-countdown>
      {%- endif -%}

      {%- if section.settings.show_signup -%}
        <bf-signup
          class="bf-signup"
          data-company-id="{{ section.settings.klaviyo_company_id | escape }}"
          data-list-id="{{ section.settings.klaviyo_list_id | escape }}"
        >
          <form novalidate>
            <label for="bf-email-{{ section.id }}" class="visually-hidden">Email</label>
            <input id="bf-email-{{ section.id }}" type="email" name="email" required autocomplete="email" placeholder="you@example.com">
            <button type="submit" class="bf-btn">{{ section.settings.signup_button }}</button>
            <p class="bf-consent">{{ section.settings.consent_text }}</p>
            <p class="bf-msg" data-bf-signup-msg role="status" aria-live="polite"></p>
          </form>
        </bf-signup>
      {%- endif -%}
    </div>
  </div>
  <script src="{{ 'bf-demo.js' | asset_url }}" type="module" async></script>
{%- endif -%}

{% schema %}
{
  "name": "Campaign hero",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Black Friday" },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Our biggest deals of the year. Sign up to be notified when they go live." },
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "color", "id": "bg_from", "label": "Background gradient: top", "default": "#000000" },
    { "type": "color", "id": "bg_to", "label": "Background gradient: bottom", "default": "#5a2a10" },
    { "type": "header", "content": "Call to action" },
    { "type": "text", "id": "cta_text", "label": "Button text" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "header", "content": "Countdown" },
    { "type": "text", "id": "countdown_end", "label": "Countdown end (YYYY-MM-DD HH:MM, local time)", "info": "Leave blank to hide. Hides itself when the time has passed." },
    { "type": "header", "content": "Email signup (Klaviyo)" },
    { "type": "checkbox", "id": "show_signup", "label": "Show email signup", "default": true },
    { "type": "text", "id": "signup_button", "label": "Signup button text", "default": "Notify Me" },
    { "type": "textarea", "id": "consent_text", "label": "Marketing consent text", "default": "By subscribing you agree to receive marketing emails. Unsubscribe any time." },
    { "type": "text", "id": "klaviyo_company_id", "label": "Klaviyo public API key (company ID)", "info": "Leave blank until configured." },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo list ID" }
  ],
  "presets": [{ "name": "Campaign hero" }]
}
{% endschema %}
