{%- comment -%}
  Campaign product list: reusable for "Flagship Deals", "Bestsellers", or any promotional list.
  Each product is a Theme Editor block (native product picker) with its own campaign discount.
  The discount here only drives a PREVIEW price; real prices and discounts come from Shopify.
{%- endcomment -%}

{{ 'bf-campaign.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign carousel = false
  if section.settings.display == 'carousel'
    assign carousel = true
  endif
  assign use_featured = false
  if section.settings.featured_first and carousel == false
    assign use_featured = true
  endif
  assign shown = 0
-%}

{%- if section.settings.enabled -%}
  <div class="bf-sec" style="--bf-from: {{ section.settings.bg_from }}; --bf-to: {{ section.settings.bg_to }};">
    <div class="bf-sec__in">
      {%- if section.settings.heading != blank -%}
        <h2 {% if section.settings.anchor != blank %}id="{{ section.settings.anchor | handleize }}"{% endif %}>{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.description != blank -%}
        <p class="bf-sub">{{ section.settings.description }}</p>
      {%- endif -%}

      {%- capture cards -%}
        {%- for block in section.blocks -%}
          {%- assign product = block.settings.product -%}
          {%- if product != blank and block.settings.visible -%}
            {%- assign is_featured = false -%}
            {%- if use_featured and shown == 0 -%}{%- assign is_featured = true -%}{%- endif -%}
            {%- assign shown = shown | plus: 1 -%}
            <div class="bf-cell" {{ block.shopify_attributes }}>
              {% render 'bf-product-card',
                product: product,
                featured: is_featured,
                dtype: block.settings.discount_type,
                dval: block.settings.discount_value,
                label: block.settings.promo_label,
                tag: section.settings.price_tag,
                note: section.settings.campaign_message
              %}
            </div>
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}

      {%- if shown == 0 -%}
        <p class="bf-sec__empty">Add product blocks in the Theme Editor and pick a product for each.</p>
      {%- elsif carousel -%}
        <bf-carousel class="bf-carousel">
          <div class="bf-track" data-bf-track>{{ cards }}</div>
          <div class="bf-carousel__nav">
            <button type="button" class="bf-arrow" data-bf-prev aria-label="Previous">&larr;</button>
            <button type="button" class="bf-arrow" data-bf-next aria-label="Next">&rarr;</button>
          </div>
        </bf-carousel>
      {%- else -%}
        <div class="bf-grid">{{ cards }}</div>
      {%- endif -%}
    </div>
  </div>
  <script src="{{ 'bf-demo.js' | asset_url }}" type="module" async></script>
{%- endif -%}

{% schema %}
{
  "name": "Campaign products",
  "max_blocks": 24,
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Show section", "default": true },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Featured deals" },
    { "type": "textarea", "id": "description", "label": "Description" },
    { "type": "text", "id": "anchor", "label": "Anchor ID", "info": "Used by the Campaign tabs, e.g. deals." },
    {
      "type": "select",
      "id": "display",
      "label": "Display",
      "options": [
        { "value": "grid", "label": "Grid" },
        { "value": "carousel", "label": "Carousel" }
      ],
      "default": "grid"
    },
    { "type": "checkbox", "id": "featured_first", "label": "Feature the first product (grid only)", "default": false },
    { "type": "header", "content": "Campaign price preview" },
    { "type": "text", "id": "price_tag", "label": "Price tag", "default": "Campaign price", "info": "Small label above a campaign preview price. Leave blank to hide." },
    { "type": "text", "id": "campaign_message", "label": "Campaign message", "default": "Campaign price applicable when the sale starts.", "info": "Shown under preview prices. Preview prices are display only: the cart uses the normal Shopify price until your Shopify discount is active." },
    { "type": "header", "content": "Colors" },
    { "type": "color", "id": "bg_from", "label": "Background gradient: top", "default": "#5a2a10" },
    { "type": "color", "id": "bg_to", "label": "Background gradient: bottom", "default": "#6b2a1c" }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        { "type": "product", "id": "product", "label": "Product" },
        {
          "type": "select",
          "id": "discount_type",
          "label": "Discount type",
          "options": [
            { "value": "percentage", "label": "Percentage" },
            { "value": "fixed", "label": "Fixed amount" }
          ],
          "default": "percentage"
        },
        { "type": "number", "id": "discount_value", "label": "Discount value", "info": "Percentage (e.g. 30) or amount in store currency (e.g. 10). Leave blank for normal Shopify pricing. Must match the Shopify discount you configure." },
        { "type": "text", "id": "promo_label", "label": "Promotional label (optional)" },
        { "type": "checkbox", "id": "visible", "label": "Show this product", "default": true }
      ]
    }
  ],
  "presets": [
    {
      "name": "Campaign products",
      "blocks": [{ "type": "product" }, { "type": "product" }, { "type": "product" }]
    }
  ]
}
{% endschema %}
