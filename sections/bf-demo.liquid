{%- comment -%}
  Black Friday demo page: hero + email signup, Flagship Deals, Bestsellers, BOGO Drops.
  All data is dynamic: product metafields (custom.sale_label / custom.sale_percentage)
  and published "bogo_offer" metaobjects. Nothing hardcoded.
{%- endcomment -%}

{%- liquid
  assign source = section.settings.source_collection | default: collections.all
  assign bestsellers_src = section.settings.bestsellers_collection | default: source
-%}

<div class="bf-demo" id="bf-demo-{{ section.id }}">
  <header class="bf-hero">
    <h1>{{ section.settings.heading }}</h1>
    <p>{{ section.settings.subheading }}</p>

    <bf-signup
      class="bf-signup"
      data-company-id="{{ section.settings.klaviyo_company_id | escape }}"
      data-list-id="{{ section.settings.klaviyo_list_id | escape }}"
    >
      <form novalidate>
        <label for="bf-email-{{ section.id }}" class="visually-hidden">Email</label>
        <input id="bf-email-{{ section.id }}" type="email" name="email" required autocomplete="email" placeholder="you@example.com">
        <button type="submit" class="bf-btn">Notify Me</button>
        <p class="bf-consent">
          {{ section.settings.consent_text }}
        </p>
        <p class="bf-msg" data-bf-signup-msg role="status" aria-live="polite"></p>
      </form>
    </bf-signup>
  </header>

  <nav class="bf-tabs" aria-label="Black Friday sections">
    <a href="#bf-flagship">Flagship deals</a>
    <a href="#bf-best">Bestsellers</a>
    <a href="#bf-bogo">BOGO drops</a>
  </nav>

  <section class="bf-block" aria-labelledby="bf-flagship">
    <h2 id="bf-flagship">Flagship Deals</h2>
    <p class="bf-sub">Products carrying a sale percentage metafield.</p>
    <div class="bf-grid">
      {%- assign flagship_count = 0 -%}
      {%- for product in source.products -%}
        {%- if product.metafields.custom.sale_percentage.value != blank -%}
          {%- if flagship_count < section.settings.flagship_limit -%}
            {% render 'bf-product-card', product: product %}
            {%- assign flagship_count = flagship_count | plus: 1 -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if flagship_count == 0 -%}<p>No products have custom.sale_percentage set.</p>{%- endif -%}
    </div>
  </section>

  <section class="bf-block" aria-labelledby="bf-best">
    <h2 id="bf-best">Bestsellers</h2>
    <bf-carousel class="bf-carousel">
      <div class="bf-track" data-bf-track>
        {%- for product in bestsellers_src.products limit: section.settings.bestsellers_limit -%}
          {% render 'bf-product-card', product: product %}
        {%- endfor -%}
      </div>
      <div class="bf-carousel__nav">
        <button type="button" class="bf-arrow" data-bf-prev aria-label="Previous">&larr;</button>
        <button type="button" class="bf-arrow" data-bf-next aria-label="Next">&rarr;</button>
      </div>
    </bf-carousel>
  </section>

  <section class="bf-block" aria-labelledby="bf-bogo">
    <h2 id="bf-bogo">BOGO Drops</h2>
    <div class="bf-grid bf-grid--bogo">
      {%- assign bogo_count = 0 -%}
      {%- for offer in shop.metaobjects.bogo_offer.values -%}
        {%- if offer.display_status.value == true -%}
          {%- assign q = offer.qualifying_product.value -%}
          {%- assign r = offer.reward_products.value | first -%}
          {%- if q != blank and r != blank -%}
            {%- assign bogo_count = bogo_count | plus: 1 -%}
            <bf-bogo class="bf-bogo" data-offer="{{ offer.system.handle }}">
              <h3>{{ offer.offer_title.value }}</h3>
              <p class="bf-badge bf-badge--static">{{ offer.promotional_label.value }}</p>
              <div class="bf-bogo__pair">
                {%- for item in (1..2) -%}
                  {%- if forloop.first %}{% assign p = q %}{% assign role = 'qualifying' %}{% else %}{% assign p = r %}{% assign role = 'reward' %}{% endif -%}
                  <div class="bf-bogo__item" data-role="{{ role }}">
                    <span class="bf-role">{% if role == 'qualifying' %}Buy this{% else %}Get this at reduced price{% endif %}</span>
                    <a href="{{ p.url }}">{{ p.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: p.title }}</a>
                    <h4><a href="{{ p.url }}">{{ p.title }}</a></h4>
                    <div class="bf-card__price"><span class="bf-price__current" data-bf-current>{{ p.selected_or_first_available_variant.price | money }}</span></div>
                    <select class="bf-select" data-bf-variant aria-label="{{ p.title | escape }} variant">
                      {%- for variant in p.variants -%}
                        <option value="{{ variant.id }}" data-price="{{ variant.price | money }}" {% unless variant.available %}disabled{% endunless %} {% if variant.id == p.selected_or_first_available_variant.id %}selected{% endif %}>
                          {{ variant.title }}{% unless variant.available %} (sold out){% endunless %} &ndash; {{ variant.price | money }}
                        </option>
                      {%- endfor -%}
                    </select>
                  </div>
                {%- endfor -%}
              </div>
              <p class="bf-note">Reward price is applied by Shopify's automatic discount once both items are in the cart.</p>
              <button type="button" class="bf-btn" data-bf-add-both>Add Both Products</button>
              <p class="bf-msg" data-bf-msg role="status" aria-live="polite"></p>
            </bf-bogo>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if bogo_count == 0 -%}<p>No published BOGO offers.</p>{%- endif -%}
    </div>
  </section>

  {%- if section.blocks.size > 0 -%}
    <section class="bf-block">
      <h2>{{ section.settings.trust_heading }}</h2>
      <div class="bf-trust">
        {%- for block in section.blocks -%}
          <div class="bf-trust__item" {{ block.shopify_attributes }}>
            <h3>{{ block.settings.title }}</h3>
            <p>{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
    </section>
  {%- endif -%}
</div>

<script src="{{ 'bf-demo.js' | asset_url }}" type="module" async></script>

{% stylesheet %}
  .bf-demo { scroll-behavior: smooth; --bf-orange: #ff5f00; --bf-gold: #ffd37a; position: relative; color: #fff; padding: 0 16px 72px;
    background: linear-gradient(180deg, #000 0, #000 360px, #5a2a10 560px, #6b2a1c 55%, #4a1f2e 80%, #1a0a10 100%);
    box-shadow: 0 0 0 100vmax #1a0a10; clip-path: inset(0 -100vmax); }
  .bf-demo > * { max-width: 1200px; margin-inline: auto; }
  .bf-hero { text-align: left; padding: 64px 0 72px; max-width: 1200px; }
  .bf-hero h1 { font-size: clamp(32px, 5vw, 52px); line-height: 1.1; color: var(--bf-orange); margin: 0 0 12px; font-weight: 800; }
  .bf-hero p { color: #fff; margin: 0; max-width: 520px; }
  .bf-signup form { display: flex; flex-wrap: wrap; gap: 0; max-width: 520px; margin-top: 20px; }
  .bf-signup input { flex: 1 1 220px; min-width: 0; padding: 14px 16px; border: 0; border-radius: 4px 0 0 4px; background: #fff; color: #2f2f2f; font-size: 14px; }
  .bf-signup .bf-btn { border-radius: 0 4px 4px 0; }
  .bf-consent { flex-basis: 100%; font-size: 12px; opacity: .85; margin: 10px 0 0; }
  .bf-tabs { position: sticky; top: var(--header-height, 68px); z-index: 5; display: flex; max-width: none !important; margin: 0 -16px; background: rgb(60 25 10 / .92); backdrop-filter: blur(6px); }
  .bf-tabs a { flex: 1; text-align: center; padding: 16px 8px; color: #fff; text-decoration: none; font-weight: 500; border-bottom: 2px solid transparent; }
  .bf-tabs a:hover, .bf-tabs a:focus-visible { border-bottom-color: #fff; }
  .bf-block { margin-top: 56px; }
  .bf-block h2 { scroll-margin-top: calc(var(--header-height, 68px) + 72px); text-align: center; color: var(--bf-gold); font-size: clamp(26px, 4vw, 40px); margin: 0 0 8px; font-weight: 700; }
  .bf-sub { text-align: center; color: var(--bf-gold); margin: 0 0 32px; }
  .bf-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 24px; }
  .bf-grid--bogo { grid-template-columns: repeat(auto-fill, minmax(340px, 1fr)); }
  .bf-card, .bf-bogo { position: relative; display: flex; flex-direction: column; gap: 10px; background: #fff; color: #2f2f2f; border-radius: 8px; padding: 20px 16px 16px; overflow: hidden; }
  .bf-card__media { display: block; padding-top: 12px; }
  .bf-card__media img, .bf-bogo img { width: 100%; height: auto; aspect-ratio: 1; object-fit: contain; display: block; }
  .bf-badge { position: absolute; top: 0; left: 0; background: linear-gradient(90deg, #ff9a3c, var(--bf-orange)); color: #fff; padding: 8px 28px 8px 14px; font-size: 16px; font-weight: 800; text-transform: uppercase; clip-path: polygon(0 0, 100% 0, 88% 100%, 0 100%); }
  .bf-badge--static { position: static; align-self: flex-start; margin: 0; }
  .bf-card__title, .bf-bogo h4, .bf-bogo h3 { font-size: 17px; margin: 0; font-weight: 600; }
  .bf-card__title a, .bf-bogo h4 a { color: inherit; text-decoration: none; }
  .bf-card__price { font-size: 20px; font-weight: 700; }
  .bf-price__current { color: var(--bf-orange); }
  .bf-price__compare { color: #000; margin-left: 8px; font-weight: 600; order: 2; }
  .bf-card__price { display: flex; align-items: baseline; }
  .bf-card__pct { margin: 0; font-size: 13px; color: var(--bf-orange); font-weight: 600; }
  .bf-note { font-size: 12px; color: #6b6b6b; }
  .bf-card__pct .bf-note { color: #6b6b6b; font-weight: 400; }
  .bf-select { padding: 10px; width: 100%; border: 1px solid #ddd; border-radius: 6px; background: #fff; color: #2f2f2f; }
  .bf-actions { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; margin-top: auto; }
  .bf-actions .bf-btn { padding: 12px 6px; font-size: 14px; white-space: nowrap; }
  .bf-btn { padding: 12px 16px; background: var(--bf-orange); color: #fff; border: 1px solid var(--bf-orange); border-radius: 4px; cursor: pointer; font-weight: 600; font-size: 15px; text-align: center; text-decoration: none; }
  .bf-btn--ghost { background: #fff; color: var(--bf-orange); }
  .bf-btn:hover { filter: brightness(1.08); }
  .bf-btn[disabled] { opacity: .5; cursor: not-allowed; }
  .bf-msg { font-size: 13px; min-height: 1em; margin: 0; }
  .bf-hero .bf-msg { color: #fff; }
  .bf-msg[data-state='error'] { color: #d4143a; }
  .bf-msg[data-state='ok'] { color: #0a6b2d; }
  .bf-hero .bf-msg[data-state='error'] { color: #ff8a9b; }
  .bf-hero .bf-msg[data-state='ok'] { color: #7be3a1; }
  .bf-bogo__pair { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  .bf-bogo__item { display: flex; flex-direction: column; gap: 6px; }
  .bf-role { font-size: 12px; text-transform: uppercase; color: #6b6b6b; font-weight: 600; }
  .bf-bogo__item[data-role='reward'] .bf-role { color: var(--bf-orange); }
  .bf-block:first-of-type .bf-grid > .bf-card:first-child { grid-column: 1 / -1; display: grid; grid-template-columns: 1.3fr 1fr; column-gap: 24px; align-items: center; background: linear-gradient(135deg, #ffb347, #ff5f00 60%, #7a2a2a); color: #fff; }
  .bf-block:first-of-type .bf-grid > .bf-card:first-child .bf-card__media { grid-row: 1 / span 8; background: transparent; }
  .bf-block:first-of-type .bf-grid > .bf-card:first-child .bf-card__title a, .bf-block:first-of-type .bf-grid > .bf-card:first-child .bf-card__pct, .bf-block:first-of-type .bf-grid > .bf-card:first-child .bf-note { color: #fff; }
  .bf-block:first-of-type .bf-grid > .bf-card:first-child .bf-price__current { color: #fff; }
  .bf-block:first-of-type .bf-grid > .bf-card:first-child .bf-price__compare { color: #fff; }
  .bf-block:first-of-type .bf-grid > .bf-card:first-child .bf-btn { background: #fff; color: var(--bf-orange); }
  .bf-block:first-of-type .bf-grid > .bf-card:first-child .bf-card__media img { max-height: 380px; }
  .bf-block:first-of-type .bf-grid > .bf-card:first-child .bf-card__media { grid-row: 1 / span 6; }
  .bf-carousel { position: relative; display: block; }
  .bf-track { display: flex; gap: 24px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; padding-bottom: 4px; }
  .bf-track::-webkit-scrollbar { display: none; }
  .bf-track > .bf-card { flex: 0 0 min(300px, 80%); scroll-snap-align: start; }
  .bf-carousel__nav { display: flex; justify-content: flex-end; gap: 8px; margin-top: 16px; }
  .bf-arrow { width: 40px; height: 40px; border-radius: 50%; border: 1px solid rgb(255 255 255 / .6); background: transparent; color: #fff; cursor: pointer; font-size: 18px; }
  .bf-trust { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; }
  .bf-trust__item { background: rgb(255 255 255 / .12); border-radius: 8px; padding: 28px 20px; text-align: center; }
  .bf-trust__item h3 { margin: 0 0 8px; font-size: 18px; color: #fff; }
  .bf-trust__item p { margin: 0; font-size: 14px; }
  @media (max-width: 749px) {
    .bf-block:first-of-type .bf-grid > .bf-card:first-child { display: flex; }
    .bf-hero { padding: 40px 0 48px; }
    .bf-grid, .bf-grid--bogo { grid-template-columns: 1fr; }
    .bf-signup input { border-radius: 4px; flex-basis: 100%; }
    .bf-signup .bf-btn { border-radius: 4px; margin-top: 8px; width: 100%; }
    .bf-tabs a { font-size: 13px; padding: 14px 4px; }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Black Friday demo",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Black Friday Demo" },
    { "type": "text", "id": "subheading", "label": "Subheading", "default": "Sign up to be notified when deals go live." },
    { "type": "textarea", "id": "consent_text", "label": "Marketing consent text", "default": "By subscribing you agree to receive marketing emails. Unsubscribe any time." },
    { "type": "collection", "id": "source_collection", "label": "Deals source collection (blank = all products)" },
    { "type": "range", "id": "flagship_limit", "label": "Flagship deals limit", "min": 1, "max": 12, "default": 6 },
    { "type": "collection", "id": "bestsellers_collection", "label": "Bestsellers collection (blank = deals source)" },
    { "type": "range", "id": "bestsellers_limit", "label": "Bestsellers limit", "min": 1, "max": 12, "default": 4 },
    { "type": "text", "id": "trust_heading", "label": "Trust row heading", "default": "Why shop with us?" },
    { "type": "header", "content": "Klaviyo (leave blank until configured)" },
    { "type": "text", "id": "klaviyo_company_id", "label": "Klaviyo public API key (company ID)" },
    { "type": "text", "id": "klaviyo_list_id", "label": "Klaviyo list ID" }
  ],
  "blocks": [
    {
      "type": "trust",
      "name": "Trust item",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Fast shipping" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Reliable delivery on all in-stock orders." }
      ]
    }
  ],
  "presets": [{ "name": "Black Friday demo", "blocks": [
    { "type": "trust", "settings": { "title": "Fast shipping", "text": "Reliable delivery on all in-stock orders." } },
    { "type": "trust", "settings": { "title": "Price match", "text": "Contact support to claim a price difference." } },
    { "type": "trust", "settings": { "title": "Easy returns", "text": "Extended holiday return window." } },
    { "type": "trust", "settings": { "title": "Warranty", "text": "Hassle-free replacement on eligible items." } }
  ] }]
}
{% endschema %}
