{% comment %}
  "How to buy" block — ported from Mountainside snippets/product-how-to-buy.liquid.
  A text link (question-mark icon + underlined label) in the buy box that opens a
  popup explaining the Rx verification flow: 5 numbered steps on the left, "Have
  these ready" / "How long it takes" / "Rather talk to us?" cards on the right
  (stacked on mobile).

  Theme block for the product information section. Renders only on Rx-gated
  products (tagged doctor-only). Variable copy (heading, intro, review time, file
  rules, phone, hours, email) is editable in the theme editor; the five steps
  describe the theme's own Rx flow and are fixed.
{% endcomment %}
{%- if closest.product.tags contains 'doctor-only' -%}
{%- assign htb_id = 'how-to-buy-' | append: block.id | handleize -%}
{%- assign htb_label = block.settings.button_text | default: 'How to buy this item' -%}
{%- assign htb_heading = block.settings.heading | default: 'How to buy prescription items' -%}
{%- assign htb_intro = block.settings.intro | default: 'Rx and license-required products need a verified license on your account. You do this once, and it unlocks every Rx item in the store.' -%}
{%- assign htb_review = block.settings.review_time | default: '1 business day' -%}
{%- assign htb_file_types = block.settings.file_types | default: 'JPG, PNG or PDF' -%}
{%- assign htb_file_max = block.settings.file_max | default: '10 MB' -%}
{%- assign htb_phone = block.settings.phone | default: '888-687-4334' -%}
{%- assign htb_phone_href = htb_phone | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | remove: '.' -%}
{%- assign htb_hours = block.settings.support_hours | default: 'Mon–Fri' -%}
{%- assign htb_email = block.settings.support_email | default: 'sales@mountainside-medical.com' -%}

<div class="product-how-to-buy" {{ block.shopify_attributes }}>
  <button
    type="button"
    class="product-how-to-buy__btn"
    data-htb-open="{{ htb_id }}"
    aria-haspopup="dialog"
    aria-controls="{{ htb_id }}"
  >
    <svg class="product-how-to-buy__ico" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M9.6 9.4a2.5 2.5 0 0 1 4.85.8c0 1.6-2.45 2.1-2.45 3.5"/><path d="M12 17h.01"/></svg>
    <span class="product-how-to-buy__label">{{ htb_label }}</span>
  </button>

  <div class="product-how-to-buy__modal" id="{{ htb_id }}" role="dialog" aria-modal="true" aria-labelledby="{{ htb_id }}-title" hidden>
    <div class="product-how-to-buy__scrim" data-htb-close></div>
    <div class="product-how-to-buy__panel">
      <div class="htb-head">
        <h2 class="htb-head__title" id="{{ htb_id }}-title">{{ htb_heading }}</h2>
        <p class="htb-head__intro">{{ htb_intro }}</p>
        <button type="button" class="product-how-to-buy__close" data-htb-close aria-label="Close">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
        </button>
      </div>

      <div class="htb-body">
        <ol class="htb-steps">
          <li class="htb-step">
            <span class="htb-step__num" aria-hidden="true">1</span>
            <div class="htb-step__content">
              <h3 class="htb-step__title">Create an account or sign in</h3>
              <p class="htb-step__text">Verification is stored on your account, so sign in before you start. Guest checkout cannot be used for Rx items.</p>
              {%- comment -%}
                Sign-in / create-account links. return_url brings the customer
                back to this product after logging in. Signed-in customers see a
                confirmation instead, so the step reads as already done.
              {%- endcomment -%}
              {%- if customer -%}
                <p class="htb-step__links htb-step__links--done"><span aria-hidden="true">&#10003;</span> You're signed in{% if customer.first_name != blank %} as {{ customer.first_name }}{% endif %}.</p>
              {%- else -%}
                <p class="htb-step__links">
                  <a class="htb-step__link" href="{{ routes.account_login_url }}?return_url={{ request.path | url_encode }}">Sign in &rarr;</a>
                  <span class="htb-step__links-sep" aria-hidden="true">&middot;</span>
                  <a class="htb-step__link" href="{{ routes.account_register_url }}?return_url={{ request.path | url_encode }}">Create an account</a>
                </p>
              {%- endif -%}
            </div>
          </li>
          <li class="htb-step">
            <span class="htb-step__num" aria-hidden="true">2</span>
            <div class="htb-step__content">
              <h3 class="htb-step__title">Click Verify on the product</h3>
              <p class="htb-step__text">Any item that needs a license shows this badge where the Add to Cart button normally sits.</p>
              <span class="htb-badge htb-badge--stop"><span class="htb-badge__ico" aria-hidden="true">🔒</span> License required <span class="htb-badge__sep" aria-hidden="true">·</span> <u>Verify →</u></span>
            </div>
          </li>
          <li class="htb-step">
            <span class="htb-step__num" aria-hidden="true">3</span>
            <div class="htb-step__content">
              <h3 class="htb-step__title">Fill the Rx Apply form</h3>
              <p class="htb-step__text">Name, email, license number, NPI number, state, and an upload of your license document. Takes about two minutes.</p>
            </div>
          </li>
          <li class="htb-step">
            <span class="htb-step__num" aria-hidden="true">4</span>
            <div class="htb-step__content">
              <h3 class="htb-step__title">Our team reviews it</h3>
              <p class="htb-step__text">The badge changes to Under manual review. Most licenses are cleared within {{ htb_review }}. You can keep browsing while you wait.</p>
              <span class="htb-badge htb-badge--warn"><span class="htb-badge__ico" aria-hidden="true">🔎</span> Under manual review</span>
            </div>
          </li>
          <li class="htb-step">
            <span class="htb-step__num" aria-hidden="true">5</span>
            <div class="htb-step__content">
              <h3 class="htb-step__title">Buy any Rx item</h3>
              <p class="htb-step__text">The badge turns green and Add to Cart unlocks across the whole store, not just this product. You never repeat this.</p>
              <span class="htb-badge htb-badge--ok"><span class="htb-badge__ico" aria-hidden="true">✓</span> License verified</span>
            </div>
          </li>
        </ol>

        <aside class="htb-side">
          <div class="htb-card">
            <h3 class="htb-card__title">Have these ready</h3>
            <ul class="htb-card__list">
              <li>State license number</li>
              <li>NPI number</li>
              <li>Licensing state</li>
              <li>A photo or PDF of your license — {{ htb_file_types }}, under {{ htb_file_max }}</li>
            </ul>
          </div>
          <div class="htb-card htb-card--green">
            <h3 class="htb-card__title">How long it takes</h3>
            <p class="htb-card__text">Form: about 2 minutes.<br>Review: {{ htb_review }}.<br>After that, no Rx item ever asks again.</p>
          </div>
          <div class="htb-card">
            <h3 class="htb-card__title">Rather talk to us?</h3>
            <p class="htb-card__text">
              Call <a href="tel:{{ htb_phone_href }}">{{ htb_phone }}</a><br>
              {{ htb_hours }}<br>
              <a href="mailto:{{ htb_email }}">{{ htb_email }}</a>
            </p>
          </div>
        </aside>
      </div>
    </div>
  </div>
</div>

<style>
  .product-how-to-buy {
    margin: 12px 0 14px;
  }
  .product-how-to-buy__btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 0;
    border: 0;
    background: none;
    color: #2d5a3d;
    font: inherit;
    font-size: 15px;
    font-weight: 600;
    line-height: 1.3;
    cursor: pointer;
    text-align: left;
  }
  .product-how-to-buy__ico {
    flex: none;
  }
  .product-how-to-buy__label {
    text-decoration: underline;
    text-underline-offset: 4px;
    text-decoration-thickness: 1.5px;
  }
  .product-how-to-buy__btn:hover .product-how-to-buy__label {
    text-decoration: none;
  }
  .product-how-to-buy__btn:focus-visible {
    outline: 2px solid #2d5a3d;
    outline-offset: 3px;
    border-radius: 4px;
  }

  /* ---- modal shell ---- */
  .product-how-to-buy__modal {
    position: fixed;
    inset: 0;
    z-index: 100000; /* above the sticky header, product sidebars and app widgets */
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
  }
  .product-how-to-buy__modal[hidden] {
    display: none;
  }
  .product-how-to-buy__scrim {
    position: absolute;
    inset: 0;
    background: rgba(15, 22, 18, 0.6);
  }
  .product-how-to-buy__panel {
    position: relative;
    width: 100%;
    max-width: 920px;
    max-height: 94vh;
    overflow-y: auto;
    overscroll-behavior: contain;
    box-sizing: border-box;
    background: #fff;
    border-radius: 16px;
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.25);
    color: #1b2620;
    text-align: left;
  }
  .product-how-to-buy__close {
    position: absolute;
    top: 14px;
    right: 14px;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    padding: 0;
    border: 1px solid #e2e8e4;
    border-radius: 10px;
    background: #fff;
    color: #1b2620;
    cursor: pointer;
  }
  .product-how-to-buy__close:hover {
    background: #eef6ee;
  }
  body.product-how-to-buy--open {
    overflow: hidden;
  }

  /* ---- header ---- */
  .htb-head {
    position: relative;
    padding: 18px 64px 14px 26px;
    border-bottom: 1px solid #e6ebe8;
  }
  .htb-head__title {
    margin: 0 0 6px;
    font-size: 21px;
    font-weight: 700;
    line-height: 1.2;
    color: #1b2620;
  }
  .htb-head__intro {
    margin: 0;
    max-width: 760px;
    font-size: 14px;
    line-height: 1.5;
    color: #47534c;
  }

  /* ---- body grid ---- */
  .htb-body {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 264px;
    gap: 24px 28px;
    padding: 18px 26px 22px;
  }

  /* ---- steps ---- */
  .htb-steps {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .htb-step {
    position: relative;
    display: grid;
    grid-template-columns: 32px minmax(0, 1fr);
    gap: 0 14px;
    padding-bottom: 16px;
  }
  .htb-step:last-child {
    padding-bottom: 0;
  }
  .htb-step:not(:last-child)::before {
    content: "";
    position: absolute;
    left: 15px;
    top: 36px;
    bottom: 2px;
    width: 2px;
    background: #dde5df;
  }
  .htb-step__num {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: #2d5a3d;
    color: #fff;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
  }
  .htb-step__content {
    min-width: 0;
    padding-top: 5px;
  }
  .htb-step__title {
    margin: 0 0 3px;
    font-size: 15.5px;
    font-weight: 700;
    line-height: 1.3;
    color: #1b2620;
  }
  .htb-step__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.45;
    color: #47534c;
  }
  .htb-step__text + .htb-badge {
    margin-top: 10px;
  }
  /* step 1: sign-in / create-account links (or the signed-in confirmation) */
  .htb-step__links {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 4px 8px;
    margin: 8px 0 0;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.3;
  }
  .htb-step__link {
    color: #2d5a3d;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .htb-step__link:hover { color: #1e4a2d; }
  .htb-step__links-sep { color: #9aa59f; font-weight: 400; }
  .htb-step__links--done { color: #1e4a2d; }

  /* badge replicas of the on-page rx-pill states */
  .htb-badge {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: 5px 12px 5px 10px;
    border: 1px solid;
    border-radius: 999px;
    font-size: 12.5px;
    font-weight: 700;
    line-height: 1.3;
    white-space: nowrap;
  }
  .htb-badge__ico { font-size: 13px; line-height: 1; }
  .htb-badge__sep { opacity: 0.5; }
  .htb-badge u { text-underline-offset: 2px; }
  .htb-badge--stop { background: #fdeceb; border-color: #c0392b; color: #7a241b; }
  .htb-badge--warn { background: #fff6e0; border-color: #c08a12; color: #6b4e07; }
  .htb-badge--ok   { background: #e8f5ec; border-color: #2d5a3d; color: #1e4a2d; }

  /* ---- side cards ---- */
  .htb-side {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .htb-card {
    padding: 14px 16px;
    border: 1px solid #dfe6e1;
    border-radius: 12px;
    background: #fafbfa;
  }
  .htb-card--green {
    background: #eaf3ec;
    border-color: #c9dccf;
  }
  .htb-card__title {
    margin: 0 0 8px;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #3d4a43;
  }
  .htb-card--green .htb-card__title {
    color: #2d5a3d;
  }
  .htb-card__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .htb-card__list li {
    position: relative;
    margin: 0 0 6px;
    padding-left: 24px;
    font-size: 14px;
    line-height: 1.4;
    color: #1b2620;
  }
  .htb-card__list li:last-child { margin-bottom: 0; }
  .htb-card__list li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 4px;
    width: 10px;
    height: 6px;
    border-left: 2px solid #2d5a3d;
    border-bottom: 2px solid #2d5a3d;
    transform: rotate(-45deg);
  }
  .htb-card__text {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: #1b2620;
  }
  .htb-card__text a {
    color: #2d5a3d;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  /* ---- responsive ---- */
  @media screen and (max-width: 860px) {
    .htb-body {
      grid-template-columns: minmax(0, 1fr);
      gap: 28px;
    }
  }
  @media screen and (max-width: 600px) {
    .product-how-to-buy__modal {
      padding: 0;
      align-items: flex-end;
    }
    .product-how-to-buy__panel {
      max-height: 92vh;
      border-radius: 16px 16px 0 0;
    }
    .htb-head {
      padding: 20px 60px 16px 18px;
    }
    .htb-body {
      padding: 20px 18px calc(24px + env(safe-area-inset-bottom, 0px));
      gap: 24px;
    }
    .htb-step {
      padding-bottom: 22px;
    }
    .htb-badge {
      white-space: normal;
      font-size: 13px;
    }
  }
</style>

<script>
  (function () {
    var opener = document.querySelector('[data-htb-open="{{ htb_id }}"]');
    var modal = document.getElementById('{{ htb_id }}');
    if (!opener || !modal) return;
    var lastFocus = null;

    // The buy box sits inside positioned ancestors that create their own
    // stacking context, so a fixed modal left in place renders under the
    // sticky header. Hoist it to <body> so z-index applies page-wide.
    // Horizon re-renders product blocks on variant change, so drop any copy hoisted
    // by an earlier render before hoisting this one.
    document.querySelectorAll('body > [id="{{ htb_id }}"]').forEach(function (el) {
      if (el !== modal) el.remove();
    });
    if (modal.parentNode !== document.body) document.body.appendChild(modal);

    function open() {
      lastFocus = document.activeElement;
      modal.hidden = false;
      document.body.classList.add('product-how-to-buy--open');
      var close = modal.querySelector('.product-how-to-buy__close');
      if (close) close.focus();
    }
    function close() {
      modal.hidden = true;
      document.body.classList.remove('product-how-to-buy--open');
      if (lastFocus && lastFocus.focus) lastFocus.focus();
    }

    opener.addEventListener('click', open);
    modal.querySelectorAll('[data-htb-close]').forEach(function (el) {
      el.addEventListener('click', close);
    });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && !modal.hidden) close();
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Rx how to buy",
  "tag": null,
  "settings": [
    {
      "type": "paragraph",
      "content": "A text link that opens a popup explaining the 5-step Rx verification flow. Shown only on Rx-gated products (tagged doctor-only). The steps are fixed; the fields below fill in the variable copy."
    },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "How to buy this item" },
    { "type": "text", "id": "heading", "label": "Popup heading", "default": "How to buy prescription items" },
    {
      "type": "textarea",
      "id": "intro",
      "label": "Intro text",
      "default": "Rx and license-required products need a verified license on your account. You do this once, and it unlocks every Rx item in the store."
    },
    {
      "type": "text",
      "id": "review_time",
      "label": "Review time",
      "info": "Used in step 4 and the \"How long it takes\" card.",
      "default": "1 business day"
    },
    { "type": "text", "id": "file_types", "label": "Accepted license file types", "default": "JPG, PNG or PDF" },
    { "type": "text", "id": "file_max", "label": "Max license file size", "default": "10 MB" },
    { "type": "text", "id": "phone", "label": "Support phone", "default": "888-687-4334" },
    { "type": "text", "id": "support_hours", "label": "Support hours", "default": "Mon–Fri" },
    { "type": "text", "id": "support_email", "label": "Support email", "default": "sales@mountainside-medical.com" }
  ],
  "presets": [
    {
      "name": "Rx how to buy"
    }
  ]
}
{% endschema %}
